<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="145"
                android:startColor="#080C10"
                android:centerColor="#101820"
                android:endColor="#0A1218" />
        </shape>
    </item>
    <!-- Soft gold wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.15"
                android:centerY="0.1"
                android:startColor="#22C9A227"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Teal accent glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:centerX="0.9"
                android:centerY="0.85"
                android:startColor="#184ECDC4"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
