<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#070B0F" />
        </shape>
    </item>
    <!-- Strong gold corner glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="560dp"
                android:centerX="0.0"
                android:centerY="0.0"
                android:startColor="#88C9A227"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Strong teal corner glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="1.0"
                android:centerY="1.0"
                android:startColor="#664ECDC4"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Center soft wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="145"
                android:startColor="#30C9A227"
                android:centerColor="#100A1218"
                android:endColor="#284ECDC4" />
        </shape>
    </item>
    <!-- Decorative top band -->
    <item android:top="0dp" android:bottom="620dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#44C9A227"
                android:centerColor="#00000000"
                android:endColor="#334ECDC4" />
        </shape>
    </item>
</layer-list>
